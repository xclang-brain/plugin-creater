    {"name": "Shift_JIS として読めない 0xA0 のある入力は中身が分からないので、contains は通る", "ok": true, "top": {"inputs": ["inputs/memo.txt", "inputs/latin.txt"]}, "files": {"inputs/latin.txt": {"base64": "VG90YWygOiA1Cg=="}}, "criterion": {"check": {"type": "contains", "file": "inputs/latin.txt", "text": "Total"}}},
    {"name": "Shift_JIS として読めない 0x80 のある入力は中身が分からないので、not_contains は通る", "ok": true, "top": {"inputs": ["inputs/memo.txt", "inputs/latin.txt"]}, "files": {"inputs/latin.txt": {"base64": "UHJpY2UgNYAK"}}, "criterion": {"check": {"type": "not_contains", "file": "inputs/latin.txt", "text": "TODO"}}},
    {"name": "Shift_JIS として読めない 0xFD のある入力は中身が分からないので、contains は通る", "ok": true, "top": {"inputs": ["inputs/memo.txt", "inputs/latin.txt"]}, "files": {"inputs/latin.txt": {"base64": "VGVh/Qo="}}, "criterion": {"check": {"type": "contains", "file": "inputs/latin.txt", "text": "Tea"}}},
