    { "name": "regex の flags が文字でない", "ok": false, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "x", "flags": 5 } } },
    { "name": "regex の flags が null（書いていないのと同じ）", "ok": true, "needsNode": true, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "x", "flags": null } } },
    { "name": "regex の pattern が正規表現として読めない", "ok": false, "needsNode": true, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "(" } } },
    { "name": "regex の pattern に text を使っている", "ok": false, "criterion": { "check": { "type": "regex", "file": "out/*.md", "text": "x" } } },
    {"name": "unchanged に file がない", "ok": false, "criterion": {"check": {"type": "unchanged"}}},
    {"name": "unchanged に使わない項目 text がある", "ok": false, "criterion": {"check": {"type": "unchanged", "file": "inputs/memo.txt", "text": "天気"}}},
    {"name": "unchanged の file が入力のファイルに当てはまらない", "ok": false, "criterion": {"check": {"type": "unchanged", "file": "out/*.md"}}},
    {"name": "入力のない課題の unchanged", "ok": false, "top": {"inputs": "$remove"}, "criterion": {"check": {"type": "unchanged", "file": "**"}}},
