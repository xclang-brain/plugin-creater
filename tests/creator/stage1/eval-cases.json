{
  "about": "eval.json の1課題の形と採点のしかたの決まりを、1段目（template/tests/stage1/check_structure.py の check_eval）と採点の課題の読み込み（skills/test-plugin/scripts/tasks.mjs の loadTasks。grade.mjs の validateTask と inputCheckProblems を使う）の両方に通す例。ok が true の例は両方が通し、false の例は両方が断る。2つがずれると、test_check_structure.py（Python）と eval-parity.test.mjs（Node）のどちらかが落ちる。課題は base に top と criterion を重ねて作る。値が \"$remove\" の項目は消す。criterion は1つ目の基準（C-01）に重ねる。needsNode が true の例は、Python 側では node がないと確かめない。課題のフォルダには baseFiles と files（例ごと。課題のフォルダからの場所 -> 中身）のファイルを置く。中身は文字か { \"base64\": … }、null は baseFiles のファイルを置かない。入力のファイルと突き合わせる確かめ（入力のままで当てはまってしまう採点、入力に当てはまらない unchanged）も、同じ例で両方に通す。プラグインのフォルダには pluginFiles（プラグインの根からの場所 -> 中身）のファイルを置く（agent_ran の基準が指すエージェントの定義。1段目の試験の見本に同じ名前のファイルがあれば、見本のものを使う）。",
  "baseFiles": { "inputs/memo.txt": "天気のメモ\n" },
  "pluginFiles": { "com.github.copilot/agents/worker.agent.md": "---\ndescription: \"見本の作業エージェント。\"\n---\n" },
  "base": {
    "id": "T-01",
    "prompt": "題材は天気で、見本を作って",
    "inputs": ["inputs/memo.txt"],
    "settings": { "maxIterations": 3 },
    "criteria": [
      {
        "id": "C-01",
        "text": "成果物に題がある",
        "grading": "program",
        "check": { "type": "contains", "file": "out/*.md", "text": "# " }
      }
    ]
  },
  "cases": [
    { "name": "contains の基準は通る", "ok": true },
    { "name": "file_exists の基準は通る", "ok": true, "criterion": { "check": { "type": "file_exists", "file": "out/report.md" } } },
    { "name": "not_contains の基準は通る", "ok": true, "criterion": { "check": { "type": "not_contains", "file": "out/**/*.md", "text": "TODO" } } },
    { "name": "regex の基準は通る（flags つき）", "ok": true, "needsNode": true, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "^# .+", "flags": "im" } } },
    { "name": "regex の基準は通る（flags なし）", "ok": true, "needsNode": true, "criterion": { "check": { "type": "regex", "file": "out/*.md", "pattern": "\\d{4}-W\\d{2}" } } },
    { "name": "グロブの {} と [] と ? は通る", "ok": true, "criterion": { "check": { "type": "file_exists", "file": "out/report-[0-9]?.{md,txt}" } } },
    { "name": "model の基準は check がなくても通る", "ok": true, "criterion": { "grading": "model", "check": "$remove" } },
    { "name": "model の基準は check.files があれば通る", "ok": true, "criterion": { "grading": "model", "check": { "files": ["out/**/*.md", "out/*.txt"] } } },
    { "name": "課題の上限の回数 1 は通る", "ok": true, "top": { "settings": { "maxIterations": 1 } } },
    { "name": "課題の上限の回数が 3.0 でも整数として通る", "ok": true, "top": { "settings": { "maxIterations": 3.0 } } },
    { "name": "inputs や settings を省いても通る", "ok": true, "top": { "inputs": "$remove", "settings": "$remove" } },
    {"name": "unchanged の基準は通る（入力のファイルに当てはまる）", "ok": true, "criterion": {"check": {"type": "unchanged", "file": "inputs/memo.txt"}}},
    {"name": "unchanged の基準は通る（グロブで入力に当てはまる）", "ok": true, "criterion": {"check": {"type": "unchanged", "file": "inputs/*.txt"}}},
    {"name": "unchanged の基準は通る（フォルダの入力の中のファイル）", "ok": true, "top": {"inputs": ["inputs"]}, "files": {"inputs/src/a.h": "#define A 1\n"}, "criterion": {"check": {"type": "unchanged", "file": "inputs/src/a.h"}}},
    {"name": "入力にない文字を contains で確かめるのは通る", "ok": true, "criterion": {"check": {"type": "contains", "file": "inputs/memo.txt", "text": "晴れ"}}},
    {"name": "入力にある文字を not_contains で確かめるのは通る（入力を変える課題）", "ok": true, "criterion": {"check": {"type": "not_contains", "file": "inputs/memo.txt", "text": "天気"}}},
    {"name": "中身が空の入力を file_exists で確かめるのは通る", "ok": true, "top": {"inputs": ["inputs/memo.txt", "inputs/empty.txt"]}, "files": {"inputs/empty.txt": ""}, "criterion": {"check": {"type": "file_exists", "file": "inputs/empty.txt"}}},
    {"name": "入力にない正規表現は通る", "ok": true, "needsNode": true, "criterion": {"check": {"type": "regex", "file": "inputs/memo.txt", "pattern": "晴れ|雨"}}},
    {"name": "docx の入力は中の文字を調べないので、contains は通る", "ok": true, "top": {"inputs": ["inputs/memo.txt", "inputs/report.docx"]}, "files": {"inputs/report.docx": {"base64": "UEsDBAoAAAAAAA=="}}, "criterion": {"check": {"type": "contains", "file": "inputs/*.docx", "text": "PK"}}},
    {"name": "文字にできない入力は調べないので、contains は通る", "ok": true, "top": {"inputs": ["inputs/memo.txt", "inputs/data.bin"]}, "files": {"inputs/data.bin": {"base64": "QQBC"}}, "criterion": {"check": {"type": "contains", "file": "inputs/data.bin", "text": "A"}}},
    {"name": "中身が分からない入力があると、not_contains は通る", "ok": true, "top": {"inputs": ["inputs/memo.txt", "inputs/data.bin"]}, "files": {"inputs/data.bin": {"base64": "QQBC"}}, "criterion": {"check": {"type": "not_contains", "file": "inputs/*", "text": "晴れ"}}},
    {"name": "node_modules の中の入力は成果物の候補にしないので、file_exists は通る", "ok": true, "top": {"inputs": ["inputs/memo.txt", "inputs/node_modules"]}, "files": {"inputs/node_modules/p/a.txt": "x"}, "criterion": {"check": {"type": "file_exists", "file": "inputs/node_modules/**"}}},
    {"name": "node_modules の中の入力にも unchanged は当てはまる", "ok": true, "top": {"inputs": ["inputs/memo.txt", "inputs/node_modules"]}, "files": {"inputs/node_modules/p/a.txt": "x"}, "criterion": {"check": {"type": "unchanged", "file": "inputs/node_modules/p/a.txt"}}},
    {"name": "擬似の機器の道具のフォルダ bin を入力として写す課題は通る", "ok": true, "top": {"bin": "inputs/bin", "inputs": ["inputs/memo.txt", "inputs/bin"]}, "files": {"inputs/bin/kxtool": "#!/bin/sh\necho ok\n"}},
    {"name": "bin の下のファイルを入力にした課題は通る", "ok": true, "top": {"bin": "inputs/bin", "inputs": ["inputs/memo.txt", "inputs/bin/kxtool"]}, "files": {"inputs/bin/kxtool": "#!/bin/sh\n"}},
    {"name": "agent_ran の基準は、このプラグインのエージェントなら通る", "ok": true, "criterion": {"check": {"type": "agent_ran", "agent": "worker"}}},

    { "name": "check.type が includes（使えない種類）", "ok": false, "criterion": { "check": { "type": "includes", "file": "out/*.md", "text": "# " } } },
    { "name": "check.type がない", "ok": false, "criterion": { "check": { "file": "out/*.md", "text": "# " } } },
    { "name": "program なのに check がない", "ok": false, "criterion": { "check": "$remove" } },
    { "name": "program なのに check が null", "ok": false, "criterion": { "check": null } },
    { "name": "program なのに check が文字", "ok": false, "criterion": { "check": "contains" } },
    { "name": "contains に text がない", "ok": false, "criterion": { "check": { "type": "contains", "file": "out/*.md" } } },
