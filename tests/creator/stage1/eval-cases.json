    { "name": "file の区切りが \\", "ok": false, "criterion": { "check": { "type": "file_exists", "file": "out\\report.md" } } },
    { "name": "file のグロブが読めない（範囲が逆）", "ok": false, "criterion": { "check": { "type": "file_exists", "file": "out/[z-a].md" } } },
    { "name": "regex に pattern がない", "ok": false, "criterion": { "check": { "type": "regex", "file": "out/*.md" } } },
