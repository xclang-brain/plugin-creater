{
  "id": "T-01",
  "prompt": "inputs/src のセンサー値の平均のプログラムで、KX-200 の機器のログに出る平均値が期待と違います。直してください。アプリの名前は sensor です。成功の条件：機器のログに AVG=25 と出ること。制約：inputs/src/dbg_log.h は変えないこと。",
  "inputs": ["inputs/src/main.c", "inputs/src/sensor_avg.c", "inputs/src/sensor_avg.h", "inputs/src/dbg_log.h"],
  "settings": { "maxIterations": 3 },
  "criteria": [
    { "id": "C-01", "knowledge": "dp-marker", "text": "機器のコンソールに AVG=25 の行が出て、そのすぐ後に取り終わりの目印「[kxapp] sensor exited (status=0)」が出ている", "grading": "program", "check": { "type": "regex", "file": ".device/console.log", "pattern": "AVG=25\\r?\\n\\[kxapp\\] sensor exited \\(status=0\\)" } },
    { "id": "C-02", "knowledge": "dp-image", "text": "見出しの付いたイメージ（.kximg）を、機器が受け付けてインストールした", "grading": "program", "check": { "type": "regex", "file": ".device/history.jsonl", "pattern": "\"ev\": \"install\", \"file\": \"[^\"]+\", \"ok\": true" } },
    { "id": "C-03", "knowledge": "cc-static", "text": "静的リンクの ARM の実行ファイルが、機器で終了コード 0 で動いた", "grading": "program", "check": { "type": "contains", "file": ".device/history.jsonl", "text": "\"kind\": \"arm-static\", \"status\": 0" } },
    { "id": "C-04", "knowledge": "dp-steps", "text": "インストールした後に機器を再起動し、その後にアプリを動かした", "grading": "program", "check": { "type": "regex", "file": ".device/history.jsonl", "pattern": "\"activated\": \\[\"sensor\"\\].*\"ev\": \"run\", \"name\": \"sensor\", \"ok\": true", "flags": "s" } },
    { "id": "C-05", "knowledge": "dp-ip", "text": "機器のアドレス 192.168.7.2 に送った", "grading": "program", "check": { "type": "contains", "file": ".device/history.jsonl", "text": "\"addr\": \"192.168.7.2\"" } },
    { "id": "C-06", "knowledge": "log-dbg", "text": "inputs/src/dbg_log.h を変えていない", "grading": "program", "check": { "type": "unchanged", "file": "inputs/src/dbg_log.h" } }
  ]
}
